# LifePilot AI — Environment Configuration

# Server Port (Default: 3001)
PORT=3001

# Google Gemini API Key for Gemma 4
# Official Docs: https://ai.google.dev/gemma/docs/core/gemma_on_gemini_api
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6JmcQCdWBKSkByPatrBEy6g0fMozBp3iXtZuSDSzBB4zg

# Gemma 4 Model Identifier (Default: gemma-4-26b-a4b-it)
# Supported Gemma 4 models on Gemini API:
# - gemma-4-26b-a4b-it (Recommended: Mixture-of-experts 26B/4B active with thinking)
# - gemma-4-31b-it (31B parameter dense model)
AI_MODEL=gemma-4-26b-a4b-it

# Offline Fallback Behavior:
# When set to true, if no API key is provided or inference fails,
# LifePilot cleanly serves offline simulated responses clearly labeled as Demo Mode.
FALLBACK_TO_DEMO=true
