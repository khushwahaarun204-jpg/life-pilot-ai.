# LifePilot AI — Environment Configuration

# Server Port
PORT=3001

# Primary AI Model Provider: Google Gemini API / Google AI Studio
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Groq Cloud API for ultra-fast Gemma 2/4 inference
# Get an API key at: https://console.groq.com/
GROQ_API_KEY=

# Model identifier (Default: gemini-2.0-flash, or gemma2-9b-it with Groq)
AI_MODEL=gemini-2.0-flash

# When set to true, if no API key is provided or inference fails,
# LifePilot will cleanly serve offline demo responses clearly labeled as Demo Mode.
FALLBACK_TO_DEMO=true
