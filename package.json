{
  "name": "lifepilot-ai",
  "version": "1.0.0",
  "description": "LifePilot AI — Hacktoberfest: AI for Everyone. Turn everyday information into organized, understandable, actionable plans.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "keywords": [
    "lifepilot",
    "ai",
    "gemma",
    "action-planner",
    "hacktoberfest",
    "productivity",
    "accessibility"
  ],
  "author": "LifePilot Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
